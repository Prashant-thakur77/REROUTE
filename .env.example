# REROUTE — environment variable template.
# Copy to `.env.local` and fill in real values. NEVER commit real secrets.
# (.env.local / .env.yaml are gitignored; only this placeholder file is tracked.)

# ─── Supabase ────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── AI services (required) ──────────────────────────
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_API_KEY=

# ─── Multi-key quota management (optional) ───────────
GOOGLE_API_KEY_ORCHESTRATOR=
GOOGLE_API_KEY_AGENTS=
GOOGLE_API_KEY_DIGITAL_TWIN=
GOOGLE_API_KEY_SUGGESTIONS=

# ─── Intelligence APIs ───────────────────────────────
TAVILY_API_KEY=
OPENWEATHER_API_KEY=

# ─── Memory ──────────────────────────────────────────
MEM0_API_KEY=

# ─── Caching ─────────────────────────────────────────
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# ─── Monitoring (optional) ───────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ─── CopilotKit ──────────────────────────────────────
NEXT_PUBLIC_COPILOTKIT_ENABLED=true
